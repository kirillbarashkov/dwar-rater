FROM node:22-alpine AS build
ARG APP_VERSION=dev
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV VITE_APP_VERSION=${APP_VERSION}
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
# A62: свой основной конфиг — pid и временные каталоги в /tmp, иначе nginx под
# непривилегированным пользователем не стартует (не может писать в /var).
COPY nginx.main.conf /etc/nginx/nginx.conf
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    mkdir -p /tmp/client_body /tmp/proxy /tmp/fastcgi /tmp/uwsgi /tmp/scgi && \
    chown -R nginx:nginx /tmp/client_body /tmp/proxy /tmp/fastcgi /tmp/uwsgi /tmp/scgi
USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
